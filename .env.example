# ============================================================================
# gravia-pnl Environment Configuration
# ============================================================================

# Polygon RPC Node (WebSocket + HTTP)
# Free Alchemy or Infura key, or public fallback
POLYGON_RPC_WS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_HTTP=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_FALLBACK_HTTP=https://polygon-rpc.com

# Envio HyperSync (Fast Polygon indexer - Free tier, no key required)
HYPERSYNC_URL=https://polygon.hypersync.xyz

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=gravia

# Engine IPC
ENGINE_HOST=127.0.0.1
ENGINE_PORT=9999
ENGINE_QUERY_PORT=9998
ENGINE_SOCKET=/tmp/gravia_engine.sock

# Checkpoint Storage
CHECKPOINT_PATH=./data/checkpoint.json

# Ingestion Window & Safety Parameters
BACKFILL_DAYS=90
REORG_WINDOW=128
BATCH_SIZE=10000

# Prometheus Metrics Exporter Port
METRICS_PORT=9090

# Polymarket External APIs (Public, no auth needed)
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
DATA_API_URL=https://data-api.polymarket.com
