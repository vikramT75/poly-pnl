# ============================================================================
# poly-pnl Environment Configuration
# ============================================================================

# Polygon RPC Node (WebSocket + HTTP)
# Default: Free public Polygon RPC (zero config required, works out of the box)
# Optional: Replace with dedicated Alchemy / Infura / QuickNode key for higher rate limits
POLYGON_RPC_WS=wss://polygon-bor-rpc.publicnode.com
POLYGON_RPC_HTTP=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_FALLBACK_HTTP=https://1rpc.io/matic

# Envio HyperSync (Fast Polygon indexer - Free tier, no key required)
HYPERSYNC_URL=https://polygon.hypersync.xyz

# ClickHouse Configuration (Default local dev user has no password)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=polypnl

# Engine IPC
ENGINE_HOST=127.0.0.1
ENGINE_PORT=9999
ENGINE_QUERY_PORT=9998
ENGINE_SOCKET=/tmp/poly_engine.sock

# Checkpoint Storage
CHECKPOINT_PATH=./data/checkpoint.json

# Ingestion Window & Safety Parameters
BACKFILL_DAYS=90
REORG_WINDOW=128
BATCH_SIZE=10000

# Prometheus Metrics Exporter Port
METRICS_PORT=9090

# Polymarket External APIs (Public, no auth needed)
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
DATA_API_URL=https://data-api.polymarket.com
